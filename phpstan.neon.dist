includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    level: max
    phpVersion: 80400
    databaseMigrationsPath:
        - database/migrations
    paths:
        - src
        - tests/NativeAccount.php
    tmpDir: .temp/phpstan
    stubFiles:
        - stubs/facile-oidc.stub
        - stubs/runtime-effects.stub
