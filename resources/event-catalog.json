    "publication": {
        "lifecycle": "LifecycleNotifications captures the graph dispatcher and dispatches after the supplied connection outer commit, or immediately without an active transaction. Listener exceptions are contained.",
        "profile": "ProfileSynchronized implements Laravel ShouldDispatchAfterCommit and SerializesModels. Snapshot application also registers on the projection connection after commit. Listener failures follow Laravel behavior.",
        "delivery_limit": "Local callbacks are not a durable outbox and do not promise crash durability or exactly-once delivery."
    },
    "security_notes": [
        "Notifications convey observations, never authorization or account-association authority.",
        "Lifecycle payloads contain identifiers and transition facts; ProfileSynchronized carries a projection model with personal data and Laravel model restoration semantics.",
        "No credentials, tokens, session/vault identifiers or private reasons belong in public listener outputs."
    ],
    "no_op_semantics": "Distinct lifecycle transitions and authenticated refreshes may emit separate observations. Already applied unchanged or stale versioned snapshots do not emit another application notification.",
    "notes": [
        "Catalog schema_version versions this JSON format; the retained notification payloads declare no schemaVersion field or method.",
        "LifecycleNotifications is an internal dispatcher, not an emitted event.",
